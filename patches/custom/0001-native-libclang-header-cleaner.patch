+host_tag = 'linux-arm64' if platform.machine() in ('aarch64', 'arm64') else 'linux-x86'
+clang_version = os.getenv('LLVM_PREBUILTS_VERSION', 'clang-stable')
+clang_root = os.path.join(top, 'prebuilts/clang/host', host_tag, clang_version)
+if host_tag == 'linux-arm64' and not os.path.isdir(clang_root):
+    # sbox does not preserve LLVM_PREBUILTS_VERSION. Use the single installed
+    # native payload, keeping its Python bindings and shared library together.
+    candidates = [p for p in glob.glob(os.path.join(
+        top, 'prebuilts/clang/host/linux-arm64/clang-r*'))
+        if os.path.isfile(os.path.join(p, 'lib/libclang.so'))]
+    if len(candidates) != 1:
+        raise RuntimeError('Expected one ARM64 Clang payload; set LLVM_PREBUILTS_VERSION')
+    clang_root = candidates[0]
+site.addsitedir(os.path.join(clang_root, 'lib/python3/site-packages/'))
 
